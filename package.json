{
  "name": "buy-v-build-cog-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx --yes concurrently --names next,open --prefix-colors cyan,green \"pnpm --filter @console/app dev\" \"npx --yes wait-on -t 120000 tcp:127.0.0.1:3001 && npx --yes open-cli http://localhost:3001\"",
    "build": "pnpm --filter @console/app build",
    "start": "pnpm --filter @console/app start",
    "lint": "eslint",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "db:generate": "pnpm --filter @console/app db:generate",
    "db:migrate": "pnpm --filter @console/app db:migrate",
    "db:seed": "pnpm --filter @console/app db:seed",
    "db:tamper": "pnpm --filter @console/app db:tamper",
    "db:scenario": "pnpm --filter @console/app db:scenario",
    "db:setup": "pnpm --filter @console/app db:setup",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:run": "tsx scripts/run-guard.ts",
    "devin:playbook": "tsx scripts/register-playbook.ts",
    "test": "pnpm --filter @console/app test",
    "test:watch": "pnpm --filter @console/app test:watch",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:run && pnpm test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
