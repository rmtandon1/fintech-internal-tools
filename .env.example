# Copy to .env at the repository root (gitignored) and fill in.
# Without DEVIN_API_KEY the console runs but Devin is not connected: the Devin
# window says so, dispatch is refused, and nothing is written.

# The only variable Devin needs. Organisation comes from GET /v3/self.
DEVIN_API_KEY=

# Optional overrides.
# DEVIN_ORG_ID=         # otherwise resolved from the key
# DEVIN_PLAYBOOK_ID=    # otherwise the org playbook titled "Governed console run"
# GITHUB_TOKEN=         # needed for "Review and approve" and merge checks

# Companies House check on UK business KYC cases. Server-only: never sent to
# the browser or logged. Without it the check answers from recorded responses
# and labels its result test data.
COMPANIES_HOUSE_API_KEY=
# COMPANIES_HOUSE_API_BASE=   # otherwise https://api.company-information.service.gov.uk
